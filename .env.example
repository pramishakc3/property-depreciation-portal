# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depreciation
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_HOURS=8

# Optional: email the team about new requests through Microsoft Graph (Microsoft 365)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=jobs@yourcompany.com.au
NOTIFY_TO=team@yourcompany.com.au
